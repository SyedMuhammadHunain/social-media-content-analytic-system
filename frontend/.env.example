# Social Media Content Analysis System - Frontend Environment Variables
# Copy this file to .env to configure local environment variables:
#   cp .env.example .env

# Google OAuth 2.0 Client ID (from Google Cloud Console -> Credentials -> OAuth 2.0 Client IDs)
# Required only if you want to connect live Google Cloud production authentication.
# In dev/mock mode, leaving this blank allows instantaneous 1-click Google simulation.
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Backend API Gateway Base URL (default is http://localhost:8080)
VITE_API_BASE_URL=http://localhost:8080
