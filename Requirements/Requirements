    i. Post Schema - {"postId": "unique_post_id","userId": "user_id", "text": "post text", "mediaUrls": ["url1", "url2"], "timestamp": "1720748150"}
    ii. Like Schema - {"likeId": "unique_like_id", "userId": "user_id", "postId": "post_id", "timestamp": "1720741345"}
    iii. Comments Schema - {"commentId": "unique_comment_id", "userId": "user_id", "postId": "post_id", "comment": "comment text", "timestamp": "1720748150"}
    iv. Follow Schema - {"userId": "user_id", "followers": ["user2_id", "user3_id", "..."] // More Followers, "followees": ["user4_id", "user5_id", "..."]}
