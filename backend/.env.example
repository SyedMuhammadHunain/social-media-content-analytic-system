# MongoDB Atlas Cloud Credentials Template
# Copy this file to backend/.env and fill in real values
MONGODB_USERNAME=your_db_username
MONGODB_PASSWORD=your_db_password
MONGODB_CLUSTER=smcas.d8avoun.mongodb.net
MONGODB_DATABASE=SocialMediaContentAnalysisSystem
MONGODB_URI=mongodb+srv://<username>:<password>@smcas.d8avoun.mongodb.net/SocialMediaContentAnalysisSystem?retryWrites=true&w=majority

# Microsoft Azure Blob Storage (Pre-Signed SAS generation)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your_account;AccountKey=your_key;EndpointSuffix=core.windows.net
