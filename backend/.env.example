# Social Media Content Analysis System - Backend Environment Configuration Template
# SECURITY WARNING: Never commit real credentials or production keys to version control.
# In production, inject secrets via Azure Key Vault, AWS Secrets Manager, or CI/CD environment variables.
# For local development: copy this file to backend/.env and populate with local values.

# -----------------------------------------------------------------------------
# Cryptographic JWT Secret (Minimum 256-bit / 32 characters)
# Generate with: openssl rand -base64 32
# -----------------------------------------------------------------------------
JWT_SECRET=replace_with_a_secure_random_256_bit_secret_key_at_least_32_chars!

# -----------------------------------------------------------------------------
# MongoDB Atlas Database Configuration
# -----------------------------------------------------------------------------
MONGODB_USERNAME=your_db_username
MONGODB_PASSWORD=your_db_password
MONGODB_CLUSTER=smcas.d8avoun.mongodb.net
MONGODB_DATABASE=SocialMediaContentAnalysisSystem
MONGODB_URI=mongodb+srv://<username>:<password>@smcas.d8avoun.mongodb.net/SocialMediaContentAnalysisSystem?retryWrites=true&w=majority

# -----------------------------------------------------------------------------
# Microsoft Azure Blob Storage (Pre-Signed SAS Generation)
# -----------------------------------------------------------------------------
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your_account;AccountKey=your_key;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER_NAME=media-assets
AZURE_STORAGE_SAS_EXPIRY=15
